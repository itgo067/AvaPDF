<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AvaTools.Desktop.Views"
        xmlns:vm="clr-namespace:AvaTools.Desktop.ViewModels"
        xmlns:domain="clr-namespace:AvaTools.Domain;assembly=AvaTools.Domain"
        x:Class="AvaTools.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="800"
        MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Icon="/Assets/AppIcon.ico"
        Title="AvaTools · 本地 PDF 工作台">
  <Grid ColumnDefinitions="292,*">
    <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="22">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="4,4,0,26">
          <Image Source="/Assets/AppIcon.png" Width="42" Height="42" />
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="AVATOOLS" FontSize="17" FontWeight="SemiBold" LetterSpacing="1.8" Foreground="{DynamicResource PrimaryText}" />
            <TextBlock Text="PDF WORKSPACE" FontSize="10" LetterSpacing="1.5" Foreground="{DynamicResource SecondaryText}" />
          </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
            <TextBlock Text="工具箱  /  09" FontSize="11" FontWeight="SemiBold" LetterSpacing="1.2" Foreground="{DynamicResource SecondaryText}" Margin="8,0,0,2" />
            <ListBox ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}" Background="Transparent" BorderThickness="0">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="12" />
                  <Setter Property="Margin" Value="0,0,0,5" />
                  <Setter Property="CornerRadius" Value="12" />
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
                <Style Selector="ListBoxItem:selected">
                  <Setter Property="Background" Value="{DynamicResource NavSelectedBackground}" />
                </Style>
                <Style Selector="ListBoxItem:pointerover">
                  <Setter Property="Background" Value="{DynamicResource NavHoverBackground}" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="domain:PdfToolDescriptor">
                  <Grid ColumnDefinitions="38,*" MinHeight="48">
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource GlyphBackground}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Glyph}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource PrimaryText}" />
                      <TextBlock Text="{Binding Description}" FontSize="10.5" TextWrapping="Wrap" MaxWidth="172" LineHeight="15" Foreground="{DynamicResource SecondaryText}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,18,0,0" Spacing="12">
          <StackPanel Spacing="6">
            <TextBlock Text="外观主题" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" Margin="4,0,0,0" />
            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeOption}"
                      HorizontalAlignment="Stretch" MinHeight="38" CornerRadius="9"
                      Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ThemeOption">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Glyph}" FontSize="15" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <Border Padding="13" CornerRadius="12" Background="{DynamicResource LocalBadgeBackground}" BorderBrush="{DynamicResource LocalBadgeBorder}" BorderThickness="1">
            <StackPanel Spacing="5">
              <TextBlock Text="●  本地运行" Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Text="文件仅在此设备处理，不会上传。" Foreground="{DynamicResource SecondaryText}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <views:ToolWorkspaceView Grid.Column="1" DataContext="{Binding Workspace}" />
  </Grid>
</Window>
