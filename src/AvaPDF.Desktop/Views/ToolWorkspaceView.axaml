<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AvaPDF.Desktop.ViewModels"
             x:Class="AvaPDF.Desktop.Views.ToolWorkspaceView"
             x:DataType="vm:ToolWorkspaceViewModel">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="13,8" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource SemiColorPrimary}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.accent:disabled">
      <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="34,26,34,28">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,0,22">
      <StackPanel Spacing="7">
        <TextBlock Text="PDF 工具工作台" Classes="caption" LetterSpacing="1.1" />
        <TextBlock Text="{Binding CurrentTool.Name}" FontSize="29" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText0}" />
        <TextBlock Text="{Binding CurrentTool.Description}" FontSize="13" Foreground="{DynamicResource SemiColorText2}" />
      </StackPanel>
      <Border Grid.Column="1" VerticalAlignment="Center" Padding="12,8" CornerRadius="20" Background="{DynamicResource SemiColorPrimaryLight}">
        <TextBlock Text="OfficeIMO 引擎" FontSize="11" Foreground="{DynamicResource SemiColorPrimary}" />
      </Border>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16" Margin="0,0,8,0">
        <Border Classes="card" Padding="20">
          <StackPanel Spacing="15">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="01  输入文件" Classes="section" />
                <TextBlock Text="{Binding InputHint}" Classes="caption" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="清空" Classes="secondary" Command="{Binding ClearFilesCommand}" />
                <Button Content="＋ 添加文件" Classes="accent" Command="{Binding AddFilesCommand}" Padding="15,8" CornerRadius="9" />
              </StackPanel>
            </Grid>

            <Border Background="{DynamicResource SemiColorBackground0}" CornerRadius="11" Padding="8" MinHeight="92">
              <Grid>
                <StackPanel IsVisible="{Binding ShowEmptyFiles}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5" Margin="12">
                  <TextBlock Text="＋" FontSize="22" Foreground="{DynamicResource SemiColorPrimary}" HorizontalAlignment="Center" />
                  <TextBlock Text="尚未选择文件" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource SemiColorText0}" HorizontalAlignment="Center" />
                  <TextBlock Text="点击“添加文件”开始，处理顺序以列表为准。" Classes="caption" HorizontalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Files}" IsVisible="{Binding HasFiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LocalFileItem">
                    <Border BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1" Padding="8,7">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
                        <Border Width="34" Height="38" CornerRadius="7" Background="{DynamicResource SemiColorFill0}" Margin="0,0,12,0">
                          <TextBlock Text="{Binding Extension}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SemiColorPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource SemiColorText0}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Details}" Classes="caption" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="↑" Classes="secondary" Margin="5,0,0,0" Padding="9,5" Command="{Binding $parent[ItemsControl].DataContext.MoveUpCommand}" CommandParameter="{Binding}" />
                        <Button Grid.Column="3" Content="↓" Classes="secondary" Margin="5,0,0,0" Padding="9,5" Command="{Binding $parent[ItemsControl].DataContext.MoveDownCommand}" CommandParameter="{Binding}" />
                        <Button Grid.Column="4" Content="×" Classes="secondary" Margin="5,0,0,0" Padding="10,5" Command="{Binding $parent[ItemsControl].DataContext.RemoveFileCommand}" CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="20" IsVisible="{Binding ShowSplitOptions}">
          <StackPanel Spacing="12">
            <TextBlock Text="02  拆分设置" Classes="section" />
            <ComboBox ItemsSource="{Binding SplitModes}" SelectedItem="{Binding SelectedSplitMode}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SplitModeOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel IsVisible="{Binding ShowSplitPageCount}" Spacing="6">
              <TextBlock Text="每份包含的页数" Classes="caption" />
              <NumericUpDown Minimum="1" Maximum="10000" Increment="1" Value="{Binding PagesPerPart}" />
            </StackPanel>
            <StackPanel IsVisible="{Binding ShowSplitRanges}" Spacing="6">
              <TextBlock Text="拆分范围（每组生成一个文件）" Classes="caption" />
              <TextBox Text="{Binding PageRanges}" PlaceholderText="例如 1-2,3-4,7" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="20" IsVisible="{Binding ShowPageRanges}">
          <StackPanel Spacing="10">
            <TextBlock Text="02  页面范围" Classes="section" />
            <TextBox Text="{Binding PageRanges}" PlaceholderText="{Binding PageRangeWatermark}" />
            <TextBlock Text="使用英文逗号分隔，连续页面用短横线连接。" Classes="caption" />
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="20" IsVisible="{Binding ShowPageOrder}">
          <StackPanel Spacing="10">
            <TextBlock Text="02  新的页面顺序" Classes="section" />
            <TextBox Text="{Binding PageOrder}" PlaceholderText="例如 3,1-2" />
            <TextBlock Text="必须包含每一页且不能重复。例如 4 页文档可输入 3,1-2,4。" Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="20" IsVisible="{Binding ShowRotation}">
          <StackPanel Spacing="10">
            <TextBlock Text="03  旋转角度" Classes="section" />
            <ComboBox ItemsSource="{Binding RotationAngles}" SelectedItem="{Binding RotationAngle}" HorizontalAlignment="Left" MinWidth="180" />
            <TextBlock Text="页面按顺时针方向旋转。" Classes="caption" />
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="20" IsVisible="{Binding ShowOptimization}">
          <StackPanel Spacing="10">
            <TextBlock Text="02  优化配置" Classes="section" />
            <ComboBox ItemsSource="{Binding OptimizationLevels}" SelectedItem="{Binding SelectedOptimization}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:OptimizationOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="无损优化不会降低图片质量；若结果更大，将保留原始内容。" Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="20" IsVisible="{Binding ShowWatermarkOptions}">
          <StackPanel Spacing="12">
            <TextBlock Text="03  水印设置" Classes="section" />
            <ComboBox ItemsSource="{Binding WatermarkModes}" SelectedItem="{Binding SelectedWatermarkMode}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:WatermarkModeOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Text="{Binding WatermarkText}" PlaceholderText="输入水印文字" IsVisible="{Binding ShowWatermarkText}" />
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowWatermarkImage}">
              <TextBox Text="{Binding WatermarkImagePath}" PlaceholderText="选择 PNG、JPG 等水印图片" IsReadOnly="True" />
              <Button Grid.Column="1" Content="选择图片…" Classes="secondary" Margin="10,0,0,0" Command="{Binding BrowseWatermarkImageCommand}" />
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding ShowWatermarkText}">
              <StackPanel Spacing="5">
                <TextBlock Text="文字大小（点）" Classes="caption" />
                <NumericUpDown Minimum="6" Maximum="256" Increment="1" Value="{Binding WatermarkFontSize}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="旋转角度" Classes="caption" />
                <NumericUpDown Minimum="-180" Maximum="180" Increment="5" Value="{Binding WatermarkRotation}" />
              </StackPanel>
            </Grid>
            <StackPanel Spacing="5">
              <TextBlock Text="透明度（0.05–1.00）" Classes="caption" />
              <NumericUpDown Minimum="0.05" Maximum="1" Increment="0.05" Value="{Binding WatermarkOpacity}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="20" IsVisible="{Binding ShowEncryptionOptions}">
          <StackPanel Spacing="11">
            <TextBlock Text="02  AES-256 密码设置" Classes="section" />
            <TextBlock Text="打开密码（必填）" Classes="caption" />
            <TextBox Text="{Binding UserPassword}" PasswordChar="●" PlaceholderText="打开 PDF 所需的密码" />
            <TextBlock Text="所有者密码（留空则与打开密码相同）" Classes="caption" />
            <TextBox Text="{Binding OwnerPassword}" PasswordChar="●" PlaceholderText="用于修改权限或删除密码" />
            <TextBlock Text="密码仅用于当前任务，不会保存到配置文件或日志。" Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="20" IsVisible="{Binding ShowDecryptionOptions}">
          <StackPanel Spacing="11">
            <TextBlock Text="02  验证所有者密码" Classes="section" />
            <TextBox Text="{Binding OwnerPassword}" PasswordChar="●" PlaceholderText="输入当前所有者密码" />
            <TextBlock Text="仅移除受支持的 Standard Security 加密，不提供密码破解。" Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="20" IsVisible="{Binding ShowMetadataOptions}">
          <StackPanel Spacing="11">
            <TextBlock Text="02  文档元数据" Classes="section" />
            <TextBlock Text="留空的字段将保持原值。" Classes="caption" />
            <TextBox Text="{Binding MetadataTitle}" PlaceholderText="标题" />
            <TextBox Text="{Binding MetadataAuthor}" PlaceholderText="作者" />
            <TextBox Text="{Binding MetadataSubject}" PlaceholderText="主题" />
            <TextBox Text="{Binding MetadataKeywords}" PlaceholderText="关键词（使用逗号分隔）" />
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="20">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="4" Margin="0,0,0,12">
              <TextBlock Text="输出目录" Classes="section" />
              <TextBlock Text="同名文件会自动添加序号，不覆盖已有文件。" Classes="caption" />
            </StackPanel>
            <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding OutputDirectory}" VerticalContentAlignment="Center" />
            <Button Grid.Row="1" Grid.Column="1" Content="浏览…" Classes="secondary" Margin="10,0,0,0" Command="{Binding BrowseOutputFolderCommand}" />
          </Grid>
        </Border>

        <Border Classes="card" Padding="20">
          <StackPanel Spacing="13">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="准备就绪" Classes="section" />
                <TextBlock Text="{Binding StatusMessage}" Classes="caption" TextWrapping="Wrap" MaxWidth="580" />
              </StackPanel>
              <Button Grid.Column="1" Content="取消" Classes="secondary" Margin="0,0,9,0" VerticalAlignment="Center" IsVisible="{Binding IsRunning}" Command="{Binding CancelCommand}" />
              <Button Grid.Column="2" Content="开始处理  →" Classes="accent" Padding="20,11" CornerRadius="10" VerticalAlignment="Center" Command="{Binding RunCommand}" />
            </Grid>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Height="5" CornerRadius="3" />
            <Border Background="{DynamicResource SemiColorDangerLight}" CornerRadius="9" Padding="12" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SemiColorDanger}" TextWrapping="Wrap" FontSize="12" />
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="20" IsVisible="{Binding HasWarnings}">
          <StackPanel Spacing="10">
            <TextBlock Text="转换警告" Classes="section" Foreground="{DynamicResource SemiColorWarning}" />
            <TextBlock Text="PDF 已生成，但部分字体、资源或版式可能发生变化，请检查输出。" Classes="caption" TextWrapping="Wrap" />
            <Border Background="{DynamicResource SemiColorWarningLight}" CornerRadius="9" Padding="12">
              <ItemsControl ItemsSource="{Binding ConversionWarnings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" Foreground="{DynamicResource SemiColorWarning}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="20" IsVisible="{Binding HasOutputs}">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="处理结果" Classes="section" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="打开输出目录" Classes="secondary" Command="{Binding OpenOutputFolderCommand}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding OutputFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                          Content="{Binding}" Command="{Binding $parent[ItemsControl].DataContext.OpenOutputFileCommand}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
