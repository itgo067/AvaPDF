<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AvaPDF.Desktop.Views.Controls"
             x:Class="AvaPDF.Desktop.Views.Controls.NumberStepper"
             x:DataType="controls:NumberStepper">
  <UserControl.Styles>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.step">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.step:pointerover">
      <Setter Property="Background" Value="{DynamicResource NavHoverBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>
  </UserControl.Styles>
  <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="9" MinHeight="38">
    <Grid ColumnDefinitions="*,32">
      <TextBox Text="{Binding TextValue}" LostFocus="OnTextLostFocus" KeyDown="OnTextKeyDown" />
      <Border Grid.Column="1" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1,0,0,0" Margin="0,1">
        <Grid RowDefinitions="19,19">
          <Button Classes="step" Content="▲" Click="OnIncreaseClick" Focusable="False" ToolTip.Tip="增加" />
          <Button Grid.Row="1" Classes="step" Content="▼" Click="OnDecreaseClick" Focusable="False" ToolTip.Tip="减少" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
