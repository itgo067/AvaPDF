<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AvaPDF.Desktop.Views"
        xmlns:vm="clr-namespace:AvaPDF.Desktop.ViewModels"
        xmlns:domain="clr-namespace:AvaPDF.Domain;assembly=AvaPDF.Domain"
        x:Class="AvaPDF.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="800"
        MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Icon="/Assets/AppIcon.ico"
        Title="AvaPDF · 本地 PDF 工作台">
  <Grid ColumnDefinitions="278,*">
    <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="4,4,0,26">
          <Image Source="/Assets/AppIcon.png" Width="42" Height="42" />
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="AVAPDF" FontSize="17" FontWeight="SemiBold" LetterSpacing="1.8" Foreground="{DynamicResource PrimaryText}" />
            <TextBlock Text="PDF WORKSPACE" FontSize="10" LetterSpacing="1.5" Foreground="{DynamicResource SecondaryText}" />
          </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
            <TextBlock Text="工具箱  /  20" FontSize="11" FontWeight="SemiBold" LetterSpacing="1.2" Foreground="{DynamicResource SecondaryText}" Margin="6,0,0,2" />
            <ItemsControl ItemsSource="{Binding ToolCategories}">
              <ItemsControl.Styles>
                <Style Selector="Button.group">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderThickness" Value="0" />
                  <Setter Property="Padding" Value="9,8" />
                  <Setter Property="CornerRadius" Value="9" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                </Style>
                <Style Selector="Button.group:pointerover">
                  <Setter Property="Background" Value="{DynamicResource NavHoverBackground}" />
                </Style>
                <Style Selector="Button.tool">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderThickness" Value="0" />
                  <Setter Property="Padding" Value="10,8" />
                  <Setter Property="Margin" Value="0,0,0,3" />
                  <Setter Property="CornerRadius" Value="10" />
                  <Setter Property="MinHeight" Value="42" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                </Style>
                <Style Selector="Button.tool:pointerover">
                  <Setter Property="Background" Value="{DynamicResource NavHoverBackground}" />
                </Style>
                <Style Selector="Button.tool.selected">
                  <Setter Property="Background" Value="{DynamicResource NavSelectedBackground}" />
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PdfToolCategoryViewModel">
                  <StackPanel Margin="0,0,0,8">
                    <Button Classes="group" Command="{Binding $parent[Window].DataContext.ToggleCategoryCommand}" CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                          <Border Background="{DynamicResource GlyphBackground}" CornerRadius="7" Padding="6,1">
                            <TextBlock Text="{Binding Tools.Count}" FontSize="10" Foreground="{DynamicResource SecondaryText}" />
                          </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="▸" FontSize="14" Foreground="{DynamicResource SecondaryText}" IsVisible="{Binding !IsExpanded}" />
                          <TextBlock Text="▾" FontSize="14" Foreground="{DynamicResource SecondaryText}" IsVisible="{Binding IsExpanded}" />
                        </StackPanel>
                      </Grid>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Tools}" IsVisible="{Binding IsExpanded}" Margin="0,4,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PdfToolNavigationItem">
                          <Button Classes="tool" Classes.selected="{Binding IsSelected}"
                                  Command="{Binding $parent[Window].DataContext.SelectToolCommand}"
                                  CommandParameter="{Binding Descriptor}">
                            <Grid ColumnDefinitions="34,*" VerticalAlignment="Center">
                              <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource GlyphBackground}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Descriptor.Glyph}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <TextBlock Grid.Column="1" Text="{Binding Descriptor.Name}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,18,0,0" Spacing="12">
          <StackPanel Spacing="6">
            <TextBlock Text="外观主题" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" Margin="4,0,0,0" />
            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeOption}"
                      HorizontalAlignment="Stretch" MinHeight="38" CornerRadius="9"
                      Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ThemeOption">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Glyph}" FontSize="15" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <Border Padding="13" CornerRadius="12" Background="{DynamicResource LocalBadgeBackground}" BorderBrush="{DynamicResource LocalBadgeBorder}" BorderThickness="1">
            <StackPanel Spacing="5">
              <TextBlock Text="●  本地运行" Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Text="文件仅在此设备处理，不会上传。" Foreground="{DynamicResource SecondaryText}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <views:ToolWorkspaceView Grid.Column="1" DataContext="{Binding Workspace}" />
  </Grid>
</Window>
