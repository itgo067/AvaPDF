<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AvaPDF.Desktop.Views"
        xmlns:vm="clr-namespace:AvaPDF.Desktop.ViewModels"
        xmlns:u="https://irihi.tech/ursa"
        x:Class="AvaPDF.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="800"
        MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SemiColorBackground0}"
        Icon="/Assets/AppIcon.ico"
        Title="AvaPDF · 本地 PDF 工作台">
  <Grid ColumnDefinitions="278,*">
    <Border Grid.Column="0" Background="{DynamicResource SemiColorBackground1}" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="4,4,0,26">
          <Image Source="/Assets/AppIcon.png" Width="42" Height="42" />
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="AVAPDF" FontSize="17" FontWeight="SemiBold" LetterSpacing="1.8" Foreground="{DynamicResource SemiColorText0}" />
            <TextBlock Text="PDF WORKSPACE" FontSize="10" LetterSpacing="1.5" Foreground="{DynamicResource SemiColorText2}" />
          </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
          <TextBlock Text="工具箱  /  20" FontSize="11" FontWeight="SemiBold" LetterSpacing="1.2" Foreground="{DynamicResource SemiColorText2}" Margin="6,0,0,12" />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <u:NavMenu x:Name="ToolNavMenu" ItemsSource="{Binding ToolCategories}" SelectedItem="{Binding SelectedNavigationNode}"
                       ContainerPrepared="OnToolNavMenuContainerPrepared" Loaded="OnToolNavMenuLoaded"
                       Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" />
          </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,18,0,0" Spacing="12">
          <StackPanel Spacing="6">
            <TextBlock Text="外观主题" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}" Margin="4,0,0,0" />
            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeOption}"
                      HorizontalAlignment="Stretch" MinHeight="38" CornerRadius="9"
                      Background="{DynamicResource SemiColorBackground0}" BorderBrush="{DynamicResource SemiColorBorder}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ThemeOption">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Glyph}" FontSize="15" Foreground="{DynamicResource SemiColorPrimary}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="网络代理" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}" Margin="4,0,0,0" />
            <ComboBox ItemsSource="{Binding ProxyOptions}" SelectedItem="{Binding SelectedProxyOption}"
                      HorizontalAlignment="Stretch" MinHeight="38" CornerRadius="9"
                      Background="{DynamicResource SemiColorBackground0}" BorderBrush="{DynamicResource SemiColorBorder}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProxyOption">
                  <TextBlock Text="{Binding Label}" FontSize="12" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Text="{Binding CustomProxyAddress}" PlaceholderText="http://127.0.0.1:7890"
                     IsVisible="{Binding IsCustomProxy}" MinHeight="36" CornerRadius="9"
                     Background="{DynamicResource SemiColorBackground0}" BorderBrush="{DynamicResource SemiColorBorder}" />
            <Button Content="保存代理设置" Click="OnSaveProxyClick" HorizontalContentAlignment="Center" MinHeight="34" />
            <TextBlock Text="{Binding ProxyErrorMessage}" Foreground="{DynamicResource SemiColorDanger}" TextWrapping="Wrap" FontSize="11" />
          </StackPanel>
          <Border Padding="13" CornerRadius="12" Background="{DynamicResource SemiColorSuccessLight}" BorderBrush="{DynamicResource SemiColorSuccess}" BorderThickness="1">
            <StackPanel Spacing="5">
              <TextBlock Text="●  本地运行" Foreground="{DynamicResource SemiColorSuccess}" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Text="文件仅在此设备处理，不会上传。" Foreground="{DynamicResource SemiColorText2}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Button Content="关于 AvaPDF" Click="OnAboutClick" Background="Transparent" BorderThickness="0"
                  Foreground="{DynamicResource SemiColorText2}" HorizontalContentAlignment="Left" Padding="4" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Border Grid.Row="0" Background="{DynamicResource SemiColorPrimaryLight}" Padding="14,10"
              BorderBrush="{DynamicResource SemiColorPrimary}" BorderThickness="0,0,0,1" IsVisible="{Binding HasUpdate}">
        <StackPanel>
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
          <TextBlock Text="{Binding UpdateMessage}" Foreground="{DynamicResource SemiColorPrimary}"
                     VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0" />
          <TextBlock Grid.Column="1" Text="{Binding UpdateProgress, StringFormat={}{0}%}" IsVisible="{Binding IsUpdating}"
                     Foreground="{DynamicResource SemiColorPrimary}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <Button Grid.Column="2" Content="查看更新" Click="OnUpdateClick" Margin="0,0,8,0" />
          <Button Grid.Column="3" Content="下载并重启更新" Click="OnApplyUpdateClick" IsEnabled="{Binding !IsUpdating}" Margin="0,0,8,0" />
          <Button Grid.Column="4" Content="忽略此版本" Click="OnIgnoreUpdateClick" />
        </Grid>
        <TextBlock Text="{Binding UpdateErrorMessage}" Foreground="{DynamicResource SemiColorDanger}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
      <views:ToolWorkspaceView Grid.Row="1" DataContext="{Binding Workspace}" />
    </Grid>
  </Grid>
</Window>
