<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaPDF.Desktop.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WindowBackground">#F4F6FB</SolidColorBrush>
          <SolidColorBrush x:Key="SidebarBackground">#FAFBFE</SolidColorBrush>
          <SolidColorBrush x:Key="CardBackground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="CardBorder">#E1E6EF</SolidColorBrush>
          <SolidColorBrush x:Key="PrimaryText">#182137</SolidColorBrush>
          <SolidColorBrush x:Key="SecondaryText">#68748A</SolidColorBrush>
          <SolidColorBrush x:Key="AccentBrush">#7464E8</SolidColorBrush>
          <SolidColorBrush x:Key="AccentSoft">#EEEAFF</SolidColorBrush>
          <SolidColorBrush x:Key="AccentText">#5C4CC4</SolidColorBrush>
          <SolidColorBrush x:Key="SuccessBrush">#148A68</SolidColorBrush>
          <SolidColorBrush x:Key="ErrorBrush">#C84255</SolidColorBrush>
          <SolidColorBrush x:Key="ErrorBackground">#FFF0F2</SolidColorBrush>
          <SolidColorBrush x:Key="WarningBrush">#9A6700</SolidColorBrush>
          <SolidColorBrush x:Key="WarningBackground">#FFF7E0</SolidColorBrush>
          <SolidColorBrush x:Key="NavSelectedBackground">#ECE8FF</SolidColorBrush>
          <SolidColorBrush x:Key="NavHoverBackground">#EEF1F7</SolidColorBrush>
          <SolidColorBrush x:Key="GlyphBackground">#EEEAFF</SolidColorBrush>
          <SolidColorBrush x:Key="LocalBadgeBackground">#EFF9F5</SolidColorBrush>
          <SolidColorBrush x:Key="LocalBadgeBorder">#D3EAE2</SolidColorBrush>
          <SolidColorBrush x:Key="ControlBackground">#F7F8FC</SolidColorBrush>
          <SolidColorBrush x:Key="ControlBorder">#D6DDE8</SolidColorBrush>
          <SolidColorBrush x:Key="SecondaryButtonBackground">#F1F3F8</SolidColorBrush>
          <SolidColorBrush x:Key="SecondaryButtonBorder">#D9DFE9</SolidColorBrush>
          <SolidColorBrush x:Key="FileRowBorder">#E7EBF2</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WindowBackground">#0B1020</SolidColorBrush>
          <SolidColorBrush x:Key="SidebarBackground">#0D1426</SolidColorBrush>
          <SolidColorBrush x:Key="CardBackground">#151E31</SolidColorBrush>
          <SolidColorBrush x:Key="CardBorder">#26334B</SolidColorBrush>
          <SolidColorBrush x:Key="PrimaryText">#F4F7FC</SolidColorBrush>
          <SolidColorBrush x:Key="SecondaryText">#9CAAC0</SolidColorBrush>
          <SolidColorBrush x:Key="AccentBrush">#8B7CFF</SolidColorBrush>
          <SolidColorBrush x:Key="AccentSoft">#2B2753</SolidColorBrush>
          <SolidColorBrush x:Key="AccentText">#C5BCFF</SolidColorBrush>
          <SolidColorBrush x:Key="SuccessBrush">#55D6A9</SolidColorBrush>
          <SolidColorBrush x:Key="ErrorBrush">#FF8995</SolidColorBrush>
          <SolidColorBrush x:Key="ErrorBackground">#3B202D</SolidColorBrush>
          <SolidColorBrush x:Key="WarningBrush">#F2C66D</SolidColorBrush>
          <SolidColorBrush x:Key="WarningBackground">#38301A</SolidColorBrush>
          <SolidColorBrush x:Key="NavSelectedBackground">#29264C</SolidColorBrush>
          <SolidColorBrush x:Key="NavHoverBackground">#19233A</SolidColorBrush>
          <SolidColorBrush x:Key="GlyphBackground">#222D43</SolidColorBrush>
          <SolidColorBrush x:Key="LocalBadgeBackground">#111D2D</SolidColorBrush>
          <SolidColorBrush x:Key="LocalBadgeBorder">#223B3B</SolidColorBrush>
          <SolidColorBrush x:Key="ControlBackground">#101929</SolidColorBrush>
          <SolidColorBrush x:Key="ControlBorder">#33415A</SolidColorBrush>
          <SolidColorBrush x:Key="SecondaryButtonBackground">#202B40</SolidColorBrush>
          <SolidColorBrush x:Key="SecondaryButtonBorder">#33415A</SolidColorBrush>
          <SolidColorBrush x:Key="FileRowBorder">#26344A</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
