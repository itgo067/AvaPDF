[Desktop Entry]
Type=Service
Name=AvaPDF
Name[zh_CN]=AvaPDF
ServiceTypes=KonqPopupMenu/Plugin
MimeType=application/pdf;
Actions=AvaPDFExtractText
X-KDE-Priority=TopLevel
X-KDE-Submenu=AvaPDF
X-KDE-MaxNumberOfUrls=1

[Desktop Action AvaPDFExtractText]
Name=Extract Text
Name[zh_CN]=提取文本
Icon=avapdf
Exec=avapdf-job --tool extracttext --auto %F
